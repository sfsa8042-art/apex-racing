# ════════════════════════════════════════════════════════════════════
#  APEX Platform — Environment Variables
#  Copy to .env.local for local dev.
#  Set in Netlify: Site Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════

# ── REQUIRED: your GitHub repo for the .exe download button ─────────
# Format: "username/repo-name"  (no https://, no trailing slash)
NEXT_PUBLIC_GITHUB_REPO=your-username/apex-racing

# ── Storage ─────────────────────────────────────────────────────────
# Where uploaded telemetry files are stored.
# On Netlify free tier /tmp is ephemeral — good enough for MVP.
# For production use Supabase Storage or S3.
APEX_STORAGE_PATH=/tmp/apex-uploads

# ── Auth ─────────────────────────────────────────────────────────────
# Token store path (used by desktop app authentication).
APEX_TOKEN_STORE=/tmp/apex-tokens.json

# ── App URL ──────────────────────────────────────────────────────────
# Your deployed site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# ── Optional: GitHub token (avoids 60 req/hour API rate limit) ───────
# Only needed if you have high traffic or a private repo.
# Create at github.com/settings/tokens (read:packages scope only)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Next.js ──────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ── AI Race Engineer (бесплатно) ─────────────────────────────────────────────
# Получить БЕСПЛАТНО (без карты) за 1 минуту:
#   1. Зайди на aistudio.google.com
#   2. Нажми "Get API Key" → "Create API key"
#   3. Скопируй ключ сюда
# Лимиты бесплатного тарифа: 15 запросов/мин, 1 500 000 токенов/день
# Для фокус-группы из 15 человек — более чем достаточно
GEMINI_API_KEY=AIza...
