// ─── Progress helpers ──────────────────────────────────────────────────────────

export function getModuleById(id: string): ModuleContent | undefined {
  return ACADEMY_MODULES.find((m) => m.id === id);
}

export function getModulesForCategory(category: string): ModuleContent[] {
  return ACADEMY_MODULES.filter((m) => m.linkedCategory === category);
}
