/**
 * Academy content — real Russian lesson content.
 * Each lesson has title, explanation, key points, and a practical task.
 */

export interface LessonContent {
  id: string;
  title: string;
  type: "theory" | "exercise" | "task";
  durationMin: number;
  body: string;           // main explanation (markdown-ish)
  keyPoints: string[];
  practicalTask: string;
  telemetryCheck?: string; // what to look for after practice
}

export interface ModuleContent {
  id: string;
  number: number;
  title: string;
  description: string;
  tier: "beginner" | "intermediate" | "advanced";
  durationMin: number;
  telemetryMetric?: string;
  linkedCategory?: "brake" | "throttle" | "speed" | "consistency";
  lessons: LessonContent[];
}

